<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
    </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  
  <ItemGroup Condition=" '$(NugetPackageVersion)' == ''">
    <ProjectReference Include="../FileTypeInterrogator\FileTypeInterrogator.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition=" '$(NugetPackageVersion)' != '' ">
    <PackageReference Include="FileTypeInterrogator" Version="$(NugetPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <_TestFiles Include="../TestFiles/**/*.*" />
    <None Include="@(_TestFiles)">
      <Link>TestFiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
